# ============================================================
#  TireWatch — Variables de Entorno
#  Copia este archivo como .env y ajusta los valores.
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ── Django ───────────────────────────────────────────────────
# Genera una clave nueva en: https://djecrety.ir/
DJANGO_SECRET_KEY=CAMBIA-ESTO-POR-UNA-CLAVE-SEGURA-DE-50-CARACTERES

# En produccion SIEMPRE False
DJANGO_DEBUG=False

# IP o hostname del servidor separados por coma, sin espacios
# Ejemplo: 192.168.1.50,tirewatch.sti.local,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos ─────────────────────────────────────────────
# SQLite (por defecto — simple, ideal para uso interno)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# PostgreSQL (descomenta si migras en el futuro)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=tirewatch
# DB_USER=tirewatch_user
# DB_PASSWORD=password_seguro
# DB_HOST=localhost
# DB_PORT=5432

# ── API Externa de Horometros ─────────────────────────────────
# Cambiar si la IP del servidor de flota cambia
HOROMETROS_API_BASE_URL=http://192.168.38.14:8009/vehiculos
HOROMETROS_API_TIMEOUT=5

# ── CORS ──────────────────────────────────────────────────────
# Origenes permitidos si hay frontend separado
# CORS_ORIGINS=http://192.168.1.50,http://localhost:3000
