# =============================================================
#  TireWatch  —  .gitignore
# =============================================================

# ---------------------------
# Entornos Virtuales Python
# ---------------------------
env/
venv/
.venv/
backend/venv/
backend/env/

# ---------------------------
# Python / Bytecode
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---------------------------
# Django
# ---------------------------
# Base de datos local (el servidor tiene la suya propia)
db.sqlite3
*.sqlite3
*.bak
*.local-bak
backend/staticfiles/
backend/media/
backend/logs/
*.log

# ---------------------------
# NOTA: backend/.env SÍ se versiona (config definitiva de producción)
# ---------------------------

# ---------------------------
# IDE y Editores
# ---------------------------
.vscode/
.idea/
*.swp
*~

# ---------------------------
# Sistemas Operativos
# ---------------------------
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------
# Archivos de datos / cargas
# ---------------------------
*.xlsx
*.xls
*.csv
!backend/**/fixtures/*.csv
uploads/
